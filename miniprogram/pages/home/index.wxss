.hero-kicker {
  display: block;
  margin-bottom: 16rpx;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #2563eb;
}

.hero {
  color: #172033;
  border: 1rpx solid #e2e8f0;
  background: #ffffff;
  box-shadow: 0 18rpx 50rpx rgba(37, 99, 235, 0.09);
}

.hero::after {
  content: "";
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(59, 130, 246, 0.1);
}

.hero-title,
.hero-subtitle,
.hero-kicker {
  position: relative;
  z-index: 1;
}

.hero-highlight {
  color: #2563eb;
}

.hero-subtitle {
  color: #64748b;
  opacity: 1;
}

.stats {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.stat {
  box-sizing: border-box;
  display: flex;
  position: relative;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 154rpx;
  min-height: 154rpx;
  padding: 18rpx 8rpx;
  border-radius: 24rpx;
  text-align: center;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(31, 45, 74, 0.06);
}

.word-stat {
  border: 2rpx solid #dbeafe;
}

.stat-hover {
  background: #eff6ff;
}

.stat-number,
.stat-label {
  display: block;
}

.stat-number {
  color: #2563eb;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 800;
}

.time-number {
  font-size: 30rpx;
}

.goal-badge {
  position: absolute;
  top: -12rpx;
  right: -8rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  color: #92400e;
  background: #fef3c7;
  font-size: 17rpx;
  font-weight: 800;
}

.goal-setting {
  position: absolute;
  top: 10rpx;
  left: 12rpx;
  color: #60a5fa;
  font-size: 18rpx;
  font-weight: 700;
}

.stat-label {
  min-height: 34rpx;
  margin-top: 8rpx;
  color: #818ba0;
  font-size: 22rpx;
  line-height: 34rpx;
}

.starter-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff4df;
}

.starter-copy {
  flex: 1;
}

.starter-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 29rpx;
  font-weight: 750;
}

.starter-button {
  flex-shrink: 0;
  min-height: 72rpx;
  padding: 0 20rpx;
  color: #ffffff;
  background: #ef8d36;
  font-size: 25rpx;
}

.module-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.level-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 42rpx 4rpx 20rpx;
}

.level-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: #3b82f6;
  font-size: 22rpx;
  font-weight: 800;
}

.advanced-header .level-icon {
  background: #f59e0b;
}

.level-title,
.level-subtitle {
  display: block;
}

.level-title {
  font-size: 32rpx;
  font-weight: 800;
}

.level-subtitle {
  margin-top: 4rpx;
  color: #64748b;
  font-size: 22rpx;
}

.module-card {
  box-sizing: border-box;
  position: relative;
  min-height: 230rpx;
  padding: 26rpx;
  border: 1rpx solid #edf0f6;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(31, 45, 74, 0.06);
}

.points-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 6rpx 11rpx;
  border-radius: 999rpx;
  color: #2563eb;
  background: #eff6ff;
  font-size: 18rpx;
  font-weight: 700;
}

.module-card.locked {
  box-shadow: none;
  opacity: 0.58;
}

.module-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #f8fafc;
}

.module-icon image {
  width: 52rpx;
  height: 52rpx;
}

.module-title,
.module-subtitle {
  display: block;
}

.module-tag {
  display: block;
  margin-top: 14rpx;
  color: #3b82f6;
  font-size: 20rpx;
  line-height: 1.35;
  font-weight: 650;
}

.module-title {
  margin-top: 22rpx;
  font-size: 29rpx;
  font-weight: 750;
}

.module-subtitle {
  margin-top: 9rpx;
  color: #7f899d;
  font-size: 23rpx;
  line-height: 1.45;
}
