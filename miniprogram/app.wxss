page {
  min-height: 100%;
  color: #172033;
  background: #f8fafc;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  margin: 0;
  padding: 0 30rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
}

button::after {
  border: 0;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 64rpx;
}

.hero {
  overflow: hidden;
  position: relative;
  padding: 38rpx;
  border-radius: 36rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  box-shadow: 0 20rpx 50rpx rgba(37, 99, 235, 0.18);
}

.hero-title {
  display: block;
  font-size: 48rpx;
  line-height: 1.25;
  font-weight: 800;
}

.hero-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 1.6;
  opacity: 0.86;
}

.section-title {
  display: block;
  margin: 42rpx 4rpx 20rpx;
  font-size: 34rpx;
  font-weight: 750;
}

.card {
  box-sizing: border-box;
  padding: 28rpx;
  border: 1rpx solid #edf0f6;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(31, 45, 74, 0.06);
}

.muted {
  color: #7a8499;
  font-size: 26rpx;
  line-height: 1.55;
}

.primary-button {
  color: #ffffff;
  background: #2563eb;
}

.secondary-button {
  color: #46516b;
  background: #eef1f7;
}

.ghost-button {
  color: #2563eb;
  border: 2rpx solid #bfdbfe;
  background: #eff6ff;
}

.danger-button {
  color: #d4515f;
  background: #fff0f1;
}

.field-label {
  display: block;
  margin: 22rpx 0 10rpx;
  color: #566077;
  font-size: 25rpx;
  font-weight: 600;
}

.field-input,
.answer-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e8ebf3;
  border-radius: 20rpx;
  color: #172033;
  background: #fafbfe;
}

.answer-input {
  min-height: 150rpx;
}

.error-banner,
.success-banner,
.feedback-banner {
  margin: 20rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 1.55;
}

.error-banner {
  color: #b43c49;
  background: #fff0f1;
}

.success-banner {
  color: #217a54;
  background: #eaf8f1;
}

.feedback-banner {
  color: #1d4ed8;
  background: #eff6ff;
}

.loading,
.empty {
  padding: 70rpx 30rpx;
  color: #8791a7;
  text-align: center;
  line-height: 1.7;
}

.progress-line {
  display: flex;
  justify-content: space-between;
  margin-bottom: 22rpx;
  color: #7b859b;
  font-size: 25rpx;
}

.practice-question {
  display: block;
  margin: 36rpx 0;
  font-size: 46rpx;
  line-height: 1.35;
  font-weight: 800;
  text-align: center;
}

.practice-hint {
  display: block;
  color: #7b8599;
  font-size: 26rpx;
  line-height: 1.55;
  text-align: center;
}

.bottom-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.bottom-actions button {
  flex: 1;
}

.practice-nav {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.practice-nav button {
  flex: 1;
}

.nav-previous {
  color: #2563eb;
  border: 2rpx solid #bfdbfe;
  background: #eff6ff;
}

.nav-next {
  color: #ffffff;
  background: #2563eb;
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.2);
}

.nav-disabled {
  color: #94a3b8 !important;
  border-color: #e2e8f0 !important;
  background: #f1f5f9 !important;
  box-shadow: none !important;
}

.round-result-card {
  margin-top: 44rpx;
  text-align: center;
}

.round-result-emoji,
.round-result-title,
.round-result-score,
.round-result-detail,
.round-result-goal {
  display: block;
}

.round-result-emoji {
  font-size: 76rpx;
}

.round-result-title {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 800;
}

.round-result-score {
  margin-top: 18rpx;
  color: #2563eb;
  font-size: 66rpx;
  font-weight: 850;
}

.round-result-detail {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 25rpx;
}

.round-result-goal {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  color: #1d4ed8;
  background: #eff6ff;
  font-size: 25rpx;
  font-weight: 650;
}

.result-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.result-actions button {
  flex: 1;
}
