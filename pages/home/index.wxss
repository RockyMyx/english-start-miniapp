.hero-kicker {
  display: block;
  margin-bottom: 16rpx;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #2563eb;
}

.hero {
  color: #172033;
  border: 1rpx solid #e2e8f0;
  background: #ffffff;
  box-shadow: 0 18rpx 50rpx rgba(37, 99, 235, 0.09);
}

.hero::after {
  content: "";
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(59, 130, 246, 0.1);
}

.hero-title,
.hero-subtitle,
.hero-kicker {
  position: relative;
  z-index: 1;
}

.hero-highlight {
  color: #2563eb;
}

.hero-subtitle {
  color: #64748b;
  opacity: 1;
}

.stats {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.daily-plan-card {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 30rpx;
  border: 1rpx solid #bfdbfe;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #eff6ff 0%, #ffffff 72%);
  box-shadow: 0 14rpx 36rpx rgba(37, 99, 235, 0.1);
}

.daily-plan-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.daily-plan-kicker,
.daily-plan-title,
.daily-plan-summary {
  display: block;
}

.daily-plan-kicker {
  color: #2563eb;
  font-size: 19rpx;
  font-weight: 850;
  letter-spacing: 3rpx;
}

.daily-plan-title {
  margin-top: 8rpx;
  color: #172033;
  font-size: 31rpx;
  font-weight: 800;
}

.daily-plan-time {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #1d4ed8;
  background: #dbeafe;
  font-size: 21rpx;
  font-weight: 700;
}

.daily-plan-summary {
  margin-top: 22rpx;
  color: #64748b;
  font-size: 24rpx;
}

.daily-progress-track {
  overflow: hidden;
  height: 14rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #dbeafe;
}

.daily-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #2563eb, #0ea5e9);
  transition: width 0.25s ease;
}

.daily-task-preview {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  color: #475569;
  font-size: 22rpx;
  line-height: 1.7;
}

.daily-plan-button {
  margin-top: 22rpx;
  color: #ffffff;
  background: #2563eb;
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.2);
}

.free-practice-title {
  display: block;
  margin: 44rpx 4rpx 4rpx;
  color: #172033;
  font-size: 34rpx;
  font-weight: 800;
}

.stat {
  box-sizing: border-box;
  display: flex;
  position: relative;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 154rpx;
  min-height: 154rpx;
  padding: 18rpx 8rpx;
  border-radius: 24rpx;
  text-align: center;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(31, 45, 74, 0.06);
}

.word-stat {
  border: 2rpx solid #dbeafe;
}

.stat-hover {
  background: #eff6ff;
}

.stat-number,
.stat-label {
  display: block;
}

.stat-number {
  color: #2563eb;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 800;
}

.time-number {
  font-size: 30rpx;
}

.goal-badge {
  position: absolute;
  top: -12rpx;
  right: -8rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  color: #92400e;
  background: #fef3c7;
  font-size: 17rpx;
  font-weight: 800;
}

.goal-setting {
  position: absolute;
  top: 10rpx;
  left: 12rpx;
  color: #60a5fa;
  font-size: 18rpx;
  font-weight: 700;
}

.stat-label {
  min-height: 34rpx;
  margin-top: 8rpx;
  color: #818ba0;
  font-size: 22rpx;
  line-height: 34rpx;
}

.starter-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff4df;
}

.starter-copy {
  flex: 1;
}

.starter-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 29rpx;
  font-weight: 750;
}

.starter-button {
  flex-shrink: 0;
  min-height: 72rpx;
  padding: 0 20rpx;
  color: #ffffff;
  background: #ef8d36;
  font-size: 25rpx;
}

.module-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.level-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 42rpx 4rpx 20rpx;
}

.level-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: #3b82f6;
  font-size: 22rpx;
  font-weight: 800;
}

.advanced-header .level-icon {
  background: #f59e0b;
}

.level-title,
.level-subtitle {
  display: block;
}

.level-title {
  font-size: 32rpx;
  font-weight: 800;
}

.level-subtitle {
  margin-top: 4rpx;
  color: #64748b;
  font-size: 22rpx;
}

.module-card {
  box-sizing: border-box;
  position: relative;
  min-height: 218rpx;
  padding: 26rpx;
  border: 1rpx solid #edf0f6;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(31, 45, 74, 0.06);
}

.points-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 6rpx 11rpx;
  border-radius: 999rpx;
  color: #2563eb;
  background: #eff6ff;
  font-size: 18rpx;
  font-weight: 700;
}

.module-card.locked {
  box-shadow: none;
  opacity: 0.58;
}

.module-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #f8fafc;
}

.module-icon image {
  width: 52rpx;
  height: 52rpx;
}

.module-title,
.module-subtitle {
  display: block;
}

.module-title {
  margin-top: 22rpx;
  font-size: 29rpx;
  font-weight: 750;
}

.module-subtitle {
  margin-top: 9rpx;
  color: #7f899d;
  font-size: 23rpx;
  line-height: 1.45;
}

.weak-review-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid #dbeafe;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #eff6ff, #ffffff);
}

.weak-review-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  color: #ffffff;
  background: #2563eb;
  font-size: 36rpx;
  font-weight: 850;
}

.weak-review-copy {
  flex: 1;
  min-width: 0;
}

.weak-review-title,
.weak-review-subtitle {
  display: block;
}

.weak-review-title {
  color: #17233d;
  font-size: 28rpx;
  font-weight: 800;
}

.weak-review-subtitle {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 22rpx;
}

.weak-review-arrow {
  color: #60a5fa;
  font-size: 44rpx;
}

.page {
  padding-bottom: 160rpx;
}
