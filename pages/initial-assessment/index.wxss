.assessment-page { padding-bottom: 48rpx; }
.page-heading { margin: 10rpx 4rpx 28rpx; }
.eyebrow { display: block; color: #2563eb; font-size: 22rpx; font-weight: 800; letter-spacing: 3rpx; }
.page-title { display: block; margin-top: 10rpx; color: #0f172a; font-size: 42rpx; font-weight: 800; }
.page-subtitle { display: block; margin-top: 12rpx; color: #64748b; font-size: 26rpx; line-height: 1.7; }
.form-card { padding: 30rpx; }
.field-title { color: #1e293b; font-size: 28rpx; font-weight: 750; }
.field-gap { margin-top: 36rpx; }
.field-heading { display: flex; align-items: center; gap: 12rpx; }
.multi-tag { padding: 4rpx 12rpx; border-radius: 999rpx; background: #dbeafe; color: #1d4ed8; font-size: 20rpx; }
.option-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }
.option-chip { box-sizing: border-box; padding: 15rpx 22rpx; border: 2rpx solid #e2e8f0; border-radius: 16rpx; color: #475569; font-size: 25rpx; background: #fff; }
.option-selected { border-color: #2563eb; background: #eff6ff; color: #1d4ed8; font-weight: 700; }
.goal-list { display: grid; gap: 14rpx; margin-top: 18rpx; }
.goal-option { display: flex; align-items: center; justify-content: space-between; padding: 22rpx; border: 2rpx solid #e2e8f0; border-radius: 18rpx; }
.goal-selected { border-color: #2563eb; background: #eff6ff; }
.goal-label, .goal-note { display: block; }
.goal-label { color: #1e293b; font-size: 27rpx; font-weight: 700; }
.goal-note { margin-top: 5rpx; color: #94a3b8; font-size: 22rpx; }
.goal-check { color: #2563eb; font-size: 32rpx; font-weight: 800; }
.bottom-button { margin-top: 28rpx; }
.text-button, .skip-button, .debug-reset { margin-top: 16rpx; border: none; background: transparent; color: #64748b; font-size: 25rpx; }
.text-button::after, .skip-button::after, .debug-reset::after { border: none; }
.intro-hero, .result-hero { padding: 50rpx 34rpx; border-radius: 30rpx; background: linear-gradient(145deg, #172554, #2563eb); color: #fff; text-align: center; }
.intro-mark { display: flex; align-items: center; justify-content: center; width: 100rpx; height: 100rpx; margin: 0 auto; border-radius: 30rpx; background: rgba(255,255,255,.16); font-size: 52rpx; font-weight: 900; }
.intro-title { display: block; margin-top: 24rpx; font-size: 40rpx; font-weight: 800; }
.difficulty-tag { display: inline-flex; margin-top: 18rpx; padding: 7rpx 16rpx; border-radius: 999rpx; background: rgba(255,255,255,.14); color: #fff; font-size: 21rpx; }
.intro-note { display: block; margin-top: 16rpx; color: rgba(255,255,255,.78); font-size: 25rpx; line-height: 1.7; }
.dimension-list { margin-top: 24rpx; padding: 10rpx 28rpx; }
.dimension-row { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 0; border-bottom: 1rpx solid #eef2f7; }
.dimension-row:last-child { border-bottom: none; }
.dimension-row view text { display: block; color: #1e293b; font-size: 27rpx; font-weight: 700; }
.dimension-row view text:last-child { margin-top: 5rpx; color: #94a3b8; font-size: 22rpx; font-weight: 400; }
.dimension-icon { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 20rpx; background: #eff6ff; color: #2563eb; font-weight: 800; }
.question-top { margin: 10rpx 4rpx 28rpx; }
.progress-row { display: flex; justify-content: space-between; color: #475569; font-size: 24rpx; font-weight: 700; }
.progress-track { height: 12rpx; margin-top: 14rpx; overflow: hidden; border-radius: 999rpx; background: #e2e8f0; }
.progress-fill { height: 100%; border-radius: inherit; background: #2563eb; transition: width .2s; }
.question-card { min-height: 620rpx; padding: 42rpx 30rpx; text-align: center; }
.question-instruction { display: block; color: #64748b; font-size: 25rpx; }
.question-prompt { display: block; margin-top: 36rpx; color: #0f172a; font-size: 46rpx; font-weight: 850; line-height: 1.4; }
.speech-button { width: 260rpx; margin: 26rpx auto 0; border: none; border-radius: 999rpx; background: #eff6ff; color: #1d4ed8; font-size: 25rpx; }
.speech-button::after { border: none; }
.answer-options { display: grid; gap: 18rpx; margin-top: 52rpx; }
.answer-option { border: 2rpx solid #dbe3ef; border-radius: 18rpx; background: #fff; color: #1e293b; font-size: 29rpx; }
.text-answer, .voice-answer { margin-top: 54rpx; }
.answer-input { box-sizing: border-box; width: 100%; height: 92rpx; margin-bottom: 22rpx; padding: 0 24rpx; border: 2rpx solid #dbe3ef; border-radius: 18rpx; text-align: left; }
.record-button { width: 330rpx; height: 110rpx; border: none; border-radius: 999rpx; background: #2563eb; color: #fff; font-weight: 750; }
.record-button::after { border: none; }
.record-button.recording { background: #dc2626; }
.record-button.canceling { background: #64748b; }
.result-label { display: block; color: rgba(255,255,255,.72); font-size: 23rpx; }
.result-level { display: block; margin-top: 14rpx; font-size: 54rpx; font-weight: 900; }
.result-difficulty { display: block; margin-top: 8rpx; color: rgba(255,255,255,.68); font-size: 22rpx; }
.result-summary { display: block; margin-top: 20rpx; color: rgba(255,255,255,.84); font-size: 26rpx; line-height: 1.7; }
.score-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin-top: 24rpx; }
.score-card { padding: 28rpx; border-radius: 22rpx; background: #fff; text-align: center; box-shadow: 0 12rpx 32rpx rgba(15,23,42,.06); }
.score-card text { display: block; }
.score-value { color: #1d4ed8; font-size: 34rpx; font-weight: 850; }
.score-label { margin-top: 7rpx; color: #64748b; font-size: 23rpx; font-weight: 500; }
.score-change { margin-top: 10rpx; font-size: 19rpx; font-weight: 700; }
.change-up { color: #047857; }
.change-down { color: #b45309; }
.change-stable { color: #2563eb; }
.change-muted { color: #94a3b8; }
.repeat-button { margin-top: 18rpx; border: 2rpx solid #2563eb; background: #fff; color: #2563eb; font-size: 26rpx; font-weight: 750; }
.locked-card { margin-top: 80rpx; padding: 48rpx 32rpx; text-align: center; }
.locked-mark { display: inline-flex; padding: 8rpx 18rpx; border-radius: 999rpx; background: #fef3c7; color: #a16207; font-size: 22rpx; font-weight: 850; }
.locked-title { display: block; margin-top: 24rpx; color: #0f172a; font-size: 36rpx; font-weight: 800; }
.locked-note { display: block; margin: 16rpx 0 30rpx; color: #64748b; font-size: 25rpx; line-height: 1.7; }
.debug-reset { color: #b45309; }
