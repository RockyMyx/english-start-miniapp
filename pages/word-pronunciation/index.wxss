.pronunciation-card {
  position: relative;
  padding: 54rpx 34rpx 38rpx;
  border-radius: 36rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #2563eb 0%, #0ea5e9 100%);
  box-shadow: 0 22rpx 52rpx rgba(37, 99, 235, 0.2);
  text-align: center;
}

.pronunciation-index {
  position: absolute;
  top: 22rpx;
  left: 26rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  font-weight: 800;
}

.pronunciation-word,
.pronunciation-phonetic,
.pronunciation-meaning {
  display: block;
}

.pronunciation-word {
  font-size: 64rpx;
  font-weight: 850;
}

.pronunciation-phonetic {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.78;
}

.pronunciation-meaning {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.standard-audio {
  width: 72%;
  min-height: 80rpx;
  margin: 30rpx auto 0;
  color: #1d4ed8;
  background: #ffffff;
  font-size: 26rpx;
}

.record-card,
.pronunciation-result {
  margin-top: 22rpx;
  text-align: center;
}

.record-title,
.record-hint,
.recognized-text,
.result-feedback,
.result-pass,
.result-retry {
  display: block;
}

.record-title {
  color: #17233d;
  font-size: 31rpx;
  font-weight: 800;
}

.record-hint {
  margin-top: 9rpx;
  color: #64748b;
  font-size: 23rpx;
}

.record-card-cancel .record-title {
  color: #dc2626;
}

.hold-button {
  width: 100%;
  min-height: 104rpx;
  margin-top: 24rpx;
  color: #2563eb;
  border: 2rpx solid #93c5fd;
  background: #eff6ff;
}

.hold-button-active {
  color: #ffffff;
  border-color: #2563eb;
  background: #2563eb;
}

.hold-button-cancel {
  border-color: #ef4444;
  background: #ef4444;
}

.result-pass,
.result-retry {
  font-size: 32rpx;
  font-weight: 850;
}

.result-pass {
  color: #16a34a;
}

.result-retry {
  color: #ea580c;
}

.recognized-text {
  margin-top: 14rpx;
  color: #475569;
  font-size: 25rpx;
}

.score-row {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.score-row view {
  flex: 1;
  padding: 18rpx 8rpx;
  border-radius: 18rpx;
  background: #eff6ff;
}

.score-row text {
  display: block;
}

.score-row text:first-child {
  color: #2563eb;
  font-size: 34rpx;
  font-weight: 850;
}

.score-row text:last-child {
  margin-top: 4rpx;
  color: #64748b;
  font-size: 20rpx;
}

.result-feedback {
  margin-top: 18rpx;
  color: #64748b;
  font-size: 24rpx;
}
