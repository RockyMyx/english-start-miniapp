.daily-page {
  padding-top: 24rpx;
}

.daily-hero {
  padding: 38rpx 34rpx;
  border-radius: 34rpx;
  color: #ffffff;
  background: linear-gradient(140deg, #1d4ed8, #2563eb 58%, #0ea5e9);
  box-shadow: 0 18rpx 46rpx rgba(37, 99, 235, 0.22);
}

.daily-kicker,
.daily-title,
.daily-subtitle {
  display: block;
}

.daily-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  opacity: 0.76;
}

.daily-title {
  margin-top: 14rpx;
  font-size: 42rpx;
  font-weight: 850;
}

.daily-subtitle {
  margin-top: 14rpx;
  font-size: 25rpx;
  opacity: 0.82;
}

.daily-track {
  overflow: hidden;
  height: 14rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
}

.daily-fill {
  height: 100%;
  border-radius: inherit;
  background: #ffffff;
}

.checkin-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.poster-link {
  flex-shrink: 0;
  min-height: 60rpx;
  padding: 0 18rpx;
  color: #217a54;
  background: #ffffff;
  font-size: 22rpx;
}

.task-list {
  margin-top: 28rpx;
}

.task-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 28rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(31, 45, 74, 0.05);
}

.task-completed {
  border-color: #bbf7d0;
  background: #f0fdf4;
}

.task-mark {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #2563eb;
  font-size: 25rpx;
  font-weight: 800;
}

.task-completed .task-mark {
  background: #22c55e;
}

.task-copy {
  flex: 1;
}

.task-title,
.task-description,
.task-progress {
  display: block;
}

.task-title {
  font-size: 30rpx;
  font-weight: 800;
}

.task-description {
  margin-top: 7rpx;
  color: #64748b;
  font-size: 23rpx;
}

.task-progress {
  margin-top: 10rpx;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
}

.task-arrow {
  color: #94a3b8;
  font-size: 34rpx;
}

.continue-button {
  margin-top: 24rpx;
}

.complete-card,
.empty-card {
  margin-top: 26rpx;
  text-align: center;
}

.complete-icon,
.complete-title,
.empty-title {
  display: block;
}

.complete-icon {
  font-size: 72rpx;
}

.complete-title,
.empty-title {
  margin: 12rpx 0;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-card .primary-button {
  margin-top: 24rpx;
}
