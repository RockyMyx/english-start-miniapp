.me-page {
  padding-bottom: 160rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 34rpx;
  border-radius: 34rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1d4ed8, #3b82f6 64%, #38bdf8);
  box-shadow: 0 18rpx 44rpx rgba(37, 99, 235, 0.2);
}

.profile-card-active {
  opacity: 0.92;
  transform: scale(0.995);
}

.avatar-shell {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  color: #2563eb;
  background: #ffffff;
  font-size: 42rpx;
  font-weight: 850;
}

.profile-copy {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.profile-name,
.profile-note {
  display: block;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 850;
}

.profile-note {
  margin-top: 7rpx;
  font-size: 21rpx;
  opacity: 0.78;
}

.use-wechat-entry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  color: #1d4ed8;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 750;
  white-space: nowrap;
}

.profile-entry {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 88rpx;
  margin-left: 12rpx;
}

.profile-arrow {
  color: rgba(255, 255, 255, 0.9);
  font-size: 54rpx;
  font-weight: 400;
}

.menu-card {
  overflow: hidden;
  border: 1rpx solid #edf0f6;
  border-radius: 28rpx;
  background: #ffffff;
}

.menu-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid #edf0f6;
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
}

.checkin-icon { background: #f59e0b; }
.report-icon { background: #3b82f6; }
.word-icon { background: #10b981; }
.goal-icon { background: #8b5cf6; }

.menu-copy {
  flex: 1;
  margin-left: 20rpx;
}

.menu-copy text {
  display: block;
}

.menu-copy text:first-child {
  font-size: 28rpx;
  font-weight: 750;
}

.menu-copy text:last-child {
  margin-top: 5rpx;
  color: #94a3b8;
  font-size: 21rpx;
}

.menu-arrow {
  color: #cbd5e1;
  font-size: 42rpx;
}
