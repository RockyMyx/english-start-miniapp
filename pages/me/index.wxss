.me-page {
  padding-bottom: 160rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 34rpx;
  border-radius: 34rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1d4ed8, #3b82f6 64%, #38bdf8);
  box-shadow: 0 18rpx 44rpx rgba(37, 99, 235, 0.2);
}

.profile-card-active {
  opacity: 0.92;
  transform: scale(0.995);
}

.avatar-shell {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  color: #2563eb;
  background: #ffffff;
  font-size: 42rpx;
  font-weight: 850;
}

.profile-copy {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.profile-name,
.profile-note {
  display: block;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 850;
}

.profile-note {
  margin-top: 7rpx;
  font-size: 21rpx;
  opacity: 0.78;
}

.use-wechat-entry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  color: #1d4ed8;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 750;
  white-space: nowrap;
}

.profile-entry {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 88rpx;
  margin-left: 12rpx;
}

.profile-arrow {
  color: rgba(255, 255, 255, 0.9);
  font-size: 54rpx;
  font-weight: 400;
}

.membership-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #fde7bd;
  border-radius: 28rpx;
  color: #7c4a08;
  background: linear-gradient(135deg, #fffaf0, #fff3d7);
}

.membership-card-active {
  color: #fff7df;
  border-color: #2f3544;
  background: linear-gradient(135deg, #1f2937, #374151);
}

.membership-mark {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  color: #7c4a08;
  background: #f8d87a;
  font-size: 22rpx;
  font-weight: 900;
}

.membership-copy {
  flex: 1;
  min-width: 0;
}

.membership-copy text {
  display: block;
}

.membership-copy text:first-child {
  font-size: 29rpx;
  font-weight: 800;
}

.membership-copy text:last-child {
  margin-top: 6rpx;
  font-size: 21rpx;
  opacity: 0.72;
}

.membership-arrow {
  font-size: 42rpx;
  opacity: 0.65;
}

.menu-card {
  overflow: hidden;
  border: 1rpx solid #edf0f6;
  border-radius: 28rpx;
  background: #ffffff;
}

.menu-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid #edf0f6;
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
}

.checkin-icon { background: #f59e0b; }
.assessment-icon { background: #0f766e; }
.report-icon { background: #3b82f6; }
.word-icon { background: #10b981; }
.goal-icon { background: #8b5cf6; }

.menu-copy {
  flex: 1;
  margin-left: 20rpx;
}

.menu-copy text {
  display: block;
}

.menu-copy text:first-child {
  font-size: 28rpx;
  font-weight: 750;
}

.menu-copy text:last-child {
  margin-top: 5rpx;
  color: #94a3b8;
  font-size: 21rpx;
}

.menu-arrow {
  color: #cbd5e1;
  font-size: 42rpx;
}
