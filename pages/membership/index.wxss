.membership-page {
  padding-bottom: 90rpx;
}

.hero-card {
  padding: 40rpx 34rpx 34rpx;
  border-radius: 36rpx;
  color: #fff8df;
  background: linear-gradient(145deg, #2b313d, #111827);
  box-shadow: 0 22rpx 48rpx rgba(17, 24, 39, 0.24);
}

.hero-card-active {
  background: linear-gradient(145deg, #44351b, #171717);
}

.debug-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border: 2rpx dashed #93c5fd;
  border-radius: 24rpx;
  background: #eff6ff;
}

.debug-copy {
  flex: 1;
  min-width: 0;
}

.debug-title,
.debug-note {
  display: block;
}

.debug-title {
  color: #1d4ed8;
  font-size: 25rpx;
  font-weight: 800;
}

.debug-note {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 21rpx;
}

.debug-switch {
  flex-shrink: 0;
  min-height: 68rpx;
  padding: 0 20rpx;
  color: #ffffff;
  background: #2563eb;
  font-size: 22rpx;
  font-weight: 750;
}

.hero-label,
.hero-title,
.hero-note {
  display: block;
}

.hero-label {
  color: #f3cd72;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.hero-title {
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 900;
}

.hero-note {
  margin-top: 10rpx;
  color: rgba(255, 248, 223, 0.7);
  font-size: 23rpx;
}

.benefit-card {
  overflow: hidden;
  border: 1rpx solid #eceff4;
  border-radius: 28rpx;
  background: #ffffff;
}

.benefit-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 100rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid #edf0f6;
  font-size: 26rpx;
  font-weight: 700;
}

.benefit-row:last-child {
  border-bottom: 0;
}

.benefit-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 17rpx;
  color: #7c4a08;
  background: #fff0c4;
  font-size: 21rpx;
  font-weight: 850;
}

.payment-card {
  padding: 30rpx;
}

.plan-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.plan-copy {
  flex: 1;
  min-width: 0;
}

.plan-title,
.plan-note,
.payment-note {
  display: block;
}

.plan-title {
  color: #172033;
  font-size: 31rpx;
  font-weight: 850;
}

.plan-note {
  margin-top: 9rpx;
  color: #64748b;
  font-size: 22rpx;
}

.plan-price {
  flex-shrink: 0;
  color: #b7791f;
  font-weight: 900;
}

.price-symbol {
  margin-right: 4rpx;
  font-size: 25rpx;
}

.price-number {
  font-size: 48rpx;
}

.payment-button {
  margin-top: 22rpx;
}

.payment-note {
  margin-top: 14rpx;
  color: #94a3b8;
  font-size: 21rpx;
  text-align: center;
}
.service-links { display: flex; justify-content: space-between; margin-top: 16rpx; color: #2563eb; font-size: 24rpx; }

.agreement-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  background: rgba(15, 23, 42, 0.6);
}

.agreement-dialog {
  width: 100%;
  max-width: 700rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
}

.agreement-title, .agreement-meta, .agreement-heading, .agreement-body, .agreement-draft { display: block; }
.agreement-title { font-size: 34rpx; font-weight: 800; color: #172033; }
.agreement-meta { margin-top: 10rpx; color: #64748b; font-size: 22rpx; }
.agreement-content { height: 48vh; margin-top: 24rpx; }
.agreement-section { margin-bottom: 26rpx; }
.agreement-heading { margin-bottom: 10rpx; color: #172033; font-size: 26rpx; font-weight: 750; }
.agreement-body { color: #475569; font-size: 24rpx; line-height: 1.8; white-space: pre-wrap; }
.agreement-draft { margin-top: 10rpx; color: #b45309; font-size: 22rpx; }
.agreement-notice { margin-top: 22rpx; font-size: 23rpx; font-weight: 700; color: #92400e; line-height: 1.7; white-space: pre-wrap; }
.agreement-actions { display: flex; gap: 18rpx; margin-top: 22rpx; }
.agreement-cancel { flex: 1; color: #475569; background: #f1f5f9; font-size: 25rpx; }
.agreement-confirm { flex: 2; font-size: 25rpx; }
