.membership-page {
  padding-bottom: 90rpx;
}

.hero-card {
  padding: 40rpx 34rpx 34rpx;
  border-radius: 36rpx;
  color: #fff8df;
  background: linear-gradient(145deg, #2b313d, #111827);
  box-shadow: 0 22rpx 48rpx rgba(17, 24, 39, 0.24);
}

.hero-card-active {
  background: linear-gradient(145deg, #44351b, #171717);
}

.debug-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border: 2rpx dashed #93c5fd;
  border-radius: 24rpx;
  background: #eff6ff;
}

.debug-copy {
  flex: 1;
  min-width: 0;
}

.debug-title,
.debug-note {
  display: block;
}

.debug-title {
  color: #1d4ed8;
  font-size: 25rpx;
  font-weight: 800;
}

.debug-note {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 21rpx;
}

.debug-switch {
  flex-shrink: 0;
  min-height: 68rpx;
  padding: 0 20rpx;
  color: #ffffff;
  background: #2563eb;
  font-size: 22rpx;
  font-weight: 750;
}

.hero-label,
.hero-title,
.hero-note {
  display: block;
}

.hero-label {
  color: #f3cd72;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.hero-title {
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 900;
}

.hero-note {
  margin-top: 10rpx;
  color: rgba(255, 248, 223, 0.7);
  font-size: 23rpx;
}

.benefit-card {
  overflow: hidden;
  border: 1rpx solid #eceff4;
  border-radius: 28rpx;
  background: #ffffff;
}

.benefit-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 100rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid #edf0f6;
  font-size: 26rpx;
  font-weight: 700;
}

.benefit-row:last-child {
  border-bottom: 0;
}

.benefit-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 17rpx;
  color: #7c4a08;
  background: #fff0c4;
  font-size: 21rpx;
  font-weight: 850;
}

.redeem-note {
  display: block;
  color: #6b7280;
  font-size: 23rpx;
}

.code-input {
  margin-top: 22rpx;
  text-transform: uppercase;
}

.redeem-button {
  margin-top: 22rpx;
}
