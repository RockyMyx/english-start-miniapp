.profile-edit-page {
  padding-top: 40rpx;
}

.profile-form-card {
  padding: 34rpx;
}

.field-title {
  display: block;
  color: #17233d;
  font-size: 29rpx;
  font-weight: 800;
}

.avatar-picker {
  display: flex;
  flex-direction: column;
  width: 220rpx;
  min-height: 180rpx;
  margin: 26rpx auto 0;
  padding: 0;
  color: #2563eb;
  background: transparent;
}

.avatar-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  border: 5rpx solid #dbeafe;
  border-radius: 50%;
  color: #2563eb;
  background: #eff6ff;
  font-size: 46rpx;
  font-weight: 850;
}

.avatar-action {
  margin-top: 14rpx;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
}

.nickname-title {
  margin-top: 36rpx;
}

.nickname-input {
  box-sizing: border-box;
  width: 100%;
  height: 92rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid #dbe3f0;
  border-radius: 20rpx;
  color: #17233d;
  background: #f8fafc;
  font-size: 28rpx;
}

.save-profile-button {
  width: 100%;
  min-height: 94rpx;
  margin-top: 36rpx;
  color: #ffffff;
  background: #2563eb;
  box-shadow: 0 12rpx 24rpx rgba(37, 99, 235, 0.18);
}
