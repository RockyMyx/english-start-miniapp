<view class="report-page">
  <view wx:if="{{error}}" class="error-banner">{{error}}</view>
  <view wx:if="{{loading}}" class="loading">正在整理你的学习记录…</view>

  <block wx:elif="{{report}}">
    <canvas
      class="report-canvas"
      canvas-id="reportPoster"
      width="{{posterWidth}}"
      height="{{posterHeight}}"
      style="width: {{posterWidth}}px; height: {{posterHeight}}px;"
    ></canvas>

    <view class="share-actions">
      <button class="friend-share" open-type="share">分享给微信好友</button>
      <button
        class="moment-share"
        loading="{{saving}}"
        disabled="{{!posterPath || saving}}"
        bindtap="saveForMoments"
      >保存海报发朋友圈</button>
    </view>

    <view class="card detail-card">
      <text class="detail-title">最近 7 天</text>
      <view class="week-chart">
        <view wx:for="{{recentDays}}" wx:key="dateKey" class="day-column">
          <text class="day-score">{{item.score}}</text>
          <view class="bar-track">
            <view class="bar-fill" style="height: {{item.barHeight}}rpx;"></view>
          </view>
          <text class="day-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{report.personalizedLocked}}" class="card personalized-lock">
      <view class="lock-mark">VIP</view>
      <text class="lock-title">解锁个性化学习报告</text>
      <text class="lock-note">查看认读、拼写、发音和表达能力变化，以及真实学习证据和下一步建议。</text>
      <button class="unlock-button" bindtap="openMembership">开通会员解锁</button>
    </view>

    <block wx:elif="{{report.personalized}}">
      <view class="card personalized-summary">
        <text class="layer-label">一句话结论</text>
        <text class="summary-text">{{report.personalized.summary}}</text>
      </view>

      <view wx:if="{{report.personalized.baseline}}" class="baseline-card">
        <view class="baseline-heading"><text>最近能力测评</text><text>{{report.personalized.baseline.level}}</text></view>
        <view class="baseline-scores">
          <view wx:for="{{report.personalized.baseline.scoreItems}}" wx:key="label"><text>{{item.value}}</text><text>{{item.label}}</text></view>
        </view>
      </view>

      <view class="card detail-card">
        <text class="detail-title">能力变化</text>
        <view class="capability-list">
          <view wx:for="{{report.personalized.capabilities}}" wx:key="key" class="capability-row">
            <view class="capability-top">
              <text class="capability-name">{{item.label}}</text>
              <text class="trend-pill {{item.trendClass}}">{{item.trendLabel}}</text>
            </view>
            <text class="capability-performance">{{item.performance}}</text>
            <text class="capability-basis">判断依据：{{item.basis}}</text>
          </view>
        </view>
      </view>

      <view class="card detail-card evidence-card">
        <text class="detail-title">具体证据</text>
        <view wx:for="{{report.personalized.evidenceRows}}" wx:key="label" class="evidence-row"><text>{{item.label}}</text><text>{{item.text}}</text></view>
        <text wx:if="{{!report.personalized.evidenceRows.length}}" class="detail-empty">继续完成练习后，这里会展示具体学习证据。</text>
      </view>

      <view class="next-step-card">
        <text class="layer-label">下一步建议</text>
        <text class="next-step-text">{{report.personalized.nextStep}}</text>
        <button class="review-button next-step-button" bindtap="startReview">按建议开始复习</button>
      </view>
    </block>

    <view class="card detail-card">
      <view class="detail-heading">
        <text class="detail-title">薄弱词汇</text>
        <button
          wx:if="{{report.weakWords.length}}"
          class="review-button"
          bindtap="startReview"
        >开始复习</button>
      </view>
      <view wx:if="{{!report.weakWords.length}}" class="detail-empty">暂时没有薄弱词，状态很好。</view>
      <view wx:else class="weak-list">
        <view wx:for="{{report.weakWords}}" wx:key="id" class="weak-row">
          <view>
            <text class="weak-word">{{item.english}}</text>
            <text class="weak-meaning">{{item.chinese}}</text>
          </view>
          <text class="weak-accuracy">正确率 {{item.accuracy}}%</text>
        </view>
      </view>
    </view>

    <view wx:if="{{modeStats.length}}" class="card detail-card">
      <text class="detail-title">练习表现</text>
      <view class="mode-list">
        <view wx:for="{{modeStats}}" wx:key="mode" class="mode-row">
          <text>{{item.label}}</text>
          <text>{{item.attempts}} 题 · {{item.accuracy}}%</text>
        </view>
      </view>
    </view>
  </block>
</view>
