.report-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 24rpx 64rpx;
  background: linear-gradient(180deg, #eef5ff 0%, #f8fafc 55%);
}

.report-canvas {
  display: block;
  overflow: hidden;
  margin: 0 auto;
  border-radius: 32rpx;
  box-shadow: 0 26rpx 64rpx rgba(30, 58, 138, 0.22);
}

.share-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.share-actions button {
  flex: 1;
  min-height: 90rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
}

.friend-share {
  color: #ffffff;
  background: #07c160;
}

.moment-share {
  color: #ffffff;
  background: #2563eb;
}

.detail-card {
  margin-top: 24rpx;
}

.detail-heading,
.mode-row,
.weak-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-title {
  display: block;
  color: #17233d;
  font-size: 31rpx;
  font-weight: 850;
}

.week-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 230rpx;
  margin-top: 24rpx;
}

.day-column {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.day-score,
.day-label {
  color: #8290a8;
  font-size: 18rpx;
}

.bar-track {
  display: flex;
  align-items: flex-end;
  width: 24rpx;
  height: 120rpx;
  margin: 8rpx 0;
  border-radius: 999rpx;
  background: #e2e8f0;
}

.bar-fill {
  width: 100%;
  max-height: 108rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #60a5fa, #2563eb);
}

.review-button {
  width: auto;
  min-height: 64rpx;
  padding: 0 22rpx;
  color: #ffffff;
  background: #2563eb;
  font-size: 22rpx;
}

.detail-empty {
  padding: 42rpx 0 18rpx;
  color: #8791a5;
  font-size: 24rpx;
  text-align: center;
}

.weak-list,
.mode-list {
  margin-top: 18rpx;
}

.weak-row,
.mode-row {
  min-height: 82rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.weak-word,
.weak-meaning {
  display: block;
}

.weak-word {
  color: #17233d;
  font-size: 28rpx;
  font-weight: 750;
}

.weak-meaning,
.weak-accuracy,
.mode-row text:last-child {
  color: #8791a5;
  font-size: 21rpx;
}

.weak-meaning {
  margin-top: 3rpx;
}

.mode-row {
  color: #334155;
  font-size: 24rpx;
}

.personalized-lock {
  margin-top: 24rpx;
  padding: 42rpx 30rpx;
  text-align: center;
  background: linear-gradient(145deg, #fffdf5, #fff7d6);
  border: 2rpx solid #fde68a;
}

.lock-mark {
  display: inline-flex;
  padding: 7rpx 18rpx;
  border-radius: 999rpx;
  color: #92400e;
  background: #fde68a;
  font-size: 20rpx;
  font-weight: 900;
}

.lock-title,
.lock-note {
  display: block;
}

.lock-title {
  margin-top: 18rpx;
  color: #422006;
  font-size: 32rpx;
  font-weight: 850;
}

.lock-note {
  margin-top: 12rpx;
  color: #78716c;
  font-size: 24rpx;
  line-height: 1.7;
}

.unlock-button {
  margin-top: 26rpx;
  color: #fff;
  background: #b45309;
  font-size: 25rpx;
}

.personalized-summary {
  margin-top: 24rpx;
  padding: 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #1e3a8a, #2563eb);
}

.layer-label,
.summary-text,
.next-step-text {
  display: block;
}

.layer-label {
  color: rgba(255,255,255,.7);
  font-size: 21rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.summary-text {
  margin-top: 14rpx;
  font-size: 29rpx;
  font-weight: 750;
  line-height: 1.65;
}

.baseline-card {
  margin-top: 18rpx;
  padding: 26rpx;
  border: 2rpx solid #bfdbfe;
  border-radius: 24rpx;
  background: #eff6ff;
}

.baseline-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #1e3a8a;
  font-size: 24rpx;
  font-weight: 800;
}

.baseline-heading text:last-child {
  padding: 5rpx 13rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  font-size: 21rpx;
}

.baseline-scores {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-top: 22rpx;
}

.baseline-scores view {
  text-align: center;
}

.baseline-scores text {
  display: block;
  color: #1d4ed8;
  font-size: 28rpx;
  font-weight: 850;
}

.baseline-scores text:last-child {
  margin-top: 4rpx;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 500;
}

.capability-list {
  margin-top: 18rpx;
}

.capability-row {
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.capability-row:last-child {
  border-bottom: none;
}

.capability-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.capability-name {
  color: #17233d;
  font-size: 28rpx;
  font-weight: 800;
}

.trend-pill {
  padding: 6rpx 13rpx;
  border-radius: 999rpx;
  color: #64748b;
  background: #f1f5f9;
  font-size: 19rpx;
}

.trend-up { color: #047857; background: #d1fae5; }
.trend-down { color: #b45309; background: #fef3c7; }
.trend-stable { color: #1d4ed8; background: #dbeafe; }

.capability-performance,
.capability-basis {
  display: block;
}

.capability-performance {
  margin-top: 11rpx;
  color: #334155;
  font-size: 25rpx;
}

.capability-basis {
  margin-top: 6rpx;
  color: #94a3b8;
  font-size: 21rpx;
}

.evidence-row {
  display: grid;
  grid-template-columns: 130rpx 1fr;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.evidence-row:first-of-type {
  margin-top: 16rpx;
}

.evidence-row text:first-child {
  color: #2563eb;
  font-size: 23rpx;
  font-weight: 750;
}

.evidence-row text:last-child {
  color: #334155;
  font-size: 24rpx;
  line-height: 1.6;
}

.next-step-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #0f766e, #0d9488);
}

.next-step-text {
  margin-top: 14rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.65;
}

.next-step-button {
  margin: 24rpx 0 0;
  background: #fff;
  color: #0f766e;
}
