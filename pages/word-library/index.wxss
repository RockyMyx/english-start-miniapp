.library-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.page-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 46rpx;
  font-weight: 800;
}

.import-button {
  flex-shrink: 0;
  min-height: 76rpx;
  padding: 0 22rpx;
  color: #ffffff;
  border: 2rpx solid #ef8d36;
  background: #ef8d36;
  font-size: 25rpx;
  box-shadow: 0 10rpx 22rpx rgba(239, 141, 54, 0.2);
}

.form-title {
  display: block;
  margin-bottom: 6rpx;
  font-size: 31rpx;
  font-weight: 750;
}

.photo-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 22rpx;
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  box-shadow: 0 14rpx 30rpx rgba(37, 99, 235, 0.18);
}

.textbook-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 22rpx;
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #7c3aed, #8b5cf6);
  box-shadow: 0 14rpx 30rpx rgba(124, 58, 237, 0.16);
}

.textbook-entry-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  color: #7c3aed;
  background: #ffffff;
  font-size: 27rpx;
  font-weight: 850;
}

.photo-entry-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  color: #2563eb;
  background: #ffffff;
  font-size: 40rpx;
  font-weight: 850;
}

.photo-entry-copy {
  flex: 1;
  min-width: 0;
}

.photo-entry-title,
.photo-entry-subtitle {
  display: block;
}

.photo-entry-title {
  font-size: 29rpx;
  font-weight: 800;
}

.photo-entry-subtitle {
  margin-top: 6rpx;
  font-size: 21rpx;
  opacity: 0.8;
}

.photo-entry-arrow {
  font-size: 42rpx;
  opacity: 0.78;
}

.save-button {
  margin-top: 28rpx;
}

.field-input-error {
  border-color: #ef4444;
  background: #fff7f7;
  box-shadow: 0 0 0 3rpx rgba(239, 68, 68, 0.08);
}

.word-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 42rpx 4rpx 20rpx;
}

.word-section-title {
  margin: 0;
}

.clear-button {
  min-height: 68rpx;
  padding: 0 22rpx;
  color: #c5505d;
  border: 2rpx solid #f3c8cd;
  background: #fff7f7;
  font-size: 23rpx;
}

.word-groups,
.word-group {
  display: flex;
  flex-direction: column;
}

.word-groups {
  gap: 28rpx;
}

.word-group {
  gap: 14rpx;
}

.letter-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 22rpx;
  border-left: 8rpx solid #2563eb;
  border-radius: 8rpx 18rpx 18rpx 8rpx;
  background: linear-gradient(90deg, #e9edff 0%, #f6f7ff 100%);
}

.letter-title {
  color: #3f4fd0;
  font-size: 32rpx;
  font-weight: 850;
}

.letter-count {
  color: #7b85ae;
  font-size: 22rpx;
}

.word-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.word-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.word-copy {
  flex: 1;
  min-width: 0;
}

.word-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.word-english,
.word-phonetic,
.word-chinese,
.word-progress {
  display: block;
}

.word-english {
  font-size: 32rpx;
  font-weight: 750;
}

.word-chinese {
  margin-top: 7rpx;
  color: #6d778d;
  font-size: 25rpx;
}

.word-phonetic {
  margin-top: 5rpx;
  color: #2563eb;
  font-size: 23rpx;
}

.word-progress {
  margin-top: 7rpx;
  color: #9aa2b2;
  font-size: 21rpx;
}

.mastery-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 13rpx;
}

.mastery-step {
  display: flex;
  align-items: center;
  gap: 5rpx;
  padding: 6rpx 9rpx;
  border-radius: 999rpx;
  color: #94a3b8;
  background: #f1f5f9;
  font-size: 18rpx;
}

.mastery-step-done {
  color: #16764d;
  background: #e9f8f0;
}

.mastery-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  font-size: 13rpx;
  font-weight: 800;
}

.source-tag {
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  color: #2563eb;
  background: #eff6ff;
  font-size: 19rpx;
}

.remove-button {
  min-height: 64rpx;
  padding: 0 22rpx;
  color: #c5505d;
  background: #fff0f1;
  font-size: 22rpx;
}
