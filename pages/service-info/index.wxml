<view class="page service-page">
  <text class="page-title">{{title}}</text>
  <text class="meta">版本 {{version}} · {{serviceReady ? '生效日期' : '初稿更新'}} {{serviceReady ? service.effectiveDate : service.draftUpdatedDate}}</text>
  <view wx:if="{{!serviceReady}}" class="error-banner">服务资料尚未补齐，当前为待发布配置，不能据此提交审核。</view>
  <view wx:if="{{type !== 'privacy'}}" class="card"><text class="section-title">运营与联系信息</text><text class="body">运营者：{{service.operatorName || '待配置'}}
客服时间：{{service.serviceHours || '待配置'}}
预计响应：{{service.responseTime || '待配置'}}
联系邮箱：{{service.contactEmail || '待配置'}}</text></view>
  <view wx:for="{{sections}}" wx:key="title" class="card"><text class="section-title">{{item.title}}</text><text class="body">{{item.text}}</text></view>
  <block wx:if="{{type === 'privacy'}}">
    <view class="card"><text class="section-title">实际保存与删除安排</text><text class="body">{{service.retentionDetails || '待运营者配置学习数据、头像、日志、备份及账务信息的必要保存期限和删除安排，不得填写尚未执行的承诺。'}}</text></view>
  </block>
  <view wx:if="{{type !== 'privacy'}}" class="card">
    <button class="primary-button" open-type="contact" binderror="onContactError">联系客服</button>
    <button class="email-button" bindtap="copyEmail">复制联系邮箱</button>
    <text class="body small">客服用于处理学习、支付及隐私问题；无需添加个人微信、进群或私下付款。</text>
  </view>
</view>
