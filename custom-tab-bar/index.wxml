<view class="tab-shell">
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'tab-item-active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-icon">
        <image
          src="{{selected === index ? item.selectedIcon : item.icon}}"
          mode="aspectFit"
        />
        <text wx:if="{{index === 1 && pendingReviewCount}}" class="tab-badge">{{pendingReviewCount > 99 ? '99+' : pendingReviewCount}}</text>
      </view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
