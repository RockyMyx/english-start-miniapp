.tab-shell {
  position: fixed;
  z-index: 999;
  right: 0;
  bottom: 0;
  left: 0;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #e8edf5;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -10rpx 32rpx rgba(15, 23, 42, 0.07);
}

.tab-bar {
  display: flex;
  height: 108rpx;
}

.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
}

.tab-icon {
  display: flex;
  position: relative;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 54rpx;
  border-radius: 20rpx;
  background: transparent;
}

.tab-icon image {
  width: 42rpx;
  height: 42rpx;
}

.tab-text {
  margin-top: 5rpx;
  color: #94a3b8;
  font-size: 20rpx;
  font-weight: 650;
}

.tab-item-active .tab-text {
  color: #2563eb;
}

.tab-item-active .tab-icon {
  background: #eff6ff;
}

.tab-badge {
  display: flex;
  position: absolute;
  top: -12rpx;
  right: -18rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 7rpx;
  border: 3rpx solid #ffffff;
  border-radius: 999rpx;
  color: #ffffff;
  background: #ef4444;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1;
  text-align: center;
}
